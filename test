from abc import ABC, abstractmethod

#Abstract Class
class Sensor(ABC):

  @abstractmethod
  def get_reading():
    pass

#Child Classes
class PHSensor(Sensor):
  def get_reading(self):
    print("[pH Sensor] Reading: 7.3 pH (Neutral)")
    return

class TempSensor(Sensor):
  def get_reading(self):
    print("[Temperature Sensor] Reading: 25.5°C")
    return

#Instantiate

phsensor = PHSensor()
tempsensor = TempSensor()

print("--- Lab Inventory System ---")
phsensor.get_reading()
tempsensor.get_reading()
print("\n----------------------------")
